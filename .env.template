# ============================================================================
# GDO SDK - Environment Variables Template
# ============================================================================
# 
# Copia questo file come .env e configura con i tuoi valori reali.
# 
# Windows PowerShell:
#   Copy-Item .env.template .env
# 
# Linux/Mac:
#   cp .env.template .env
# 
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED - Variabili Obbligatorie
# ----------------------------------------------------------------------------

# MotherDuck Authentication Token
# Ottieni il tuo token da: https://motherduck.com/
# Questo token Ã¨ necessario per accedere al database app_gpt_gdo
MOTHERDUCK_TOKEN=your_motherduck_token_here

# ----------------------------------------------------------------------------
# OPTIONAL - Variabili Opzionali per Sviluppo Locale
# ----------------------------------------------------------------------------

# Ngrok Authentication Token
# Ottieni il tuo token da: https://dashboard.ngrok.com/get-started/your-authtoken
# Necessario solo se vuoi che ngrok venga avviato automaticamente dal server
# Se non configurato, ngrok non verrÃ  avviato automaticamente
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# ----------------------------------------------------------------------------
# OPTIONAL - Variabili Opzionali per Pagamenti (Stripe)
# ----------------------------------------------------------------------------

# Stripe Secret Key
# Necessario solo se vuoi usare la funzionalitÃ  di checkout Stripe
# Ottieni la tua chiave da: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ----------------------------------------------------------------------------
# OPTIONAL - Variabili Opzionali per Proxy Immagini
# ----------------------------------------------------------------------------

# Proxy Allowed Domains
# Lista di domini consentiti per il proxy immagini (separati da virgola)
# Se vuoto, tutti i domini sono consentiti
# Esempio: example.com,another-domain.com
PROXY_ALLOWED_DOMAINS=

# ----------------------------------------------------------------------------
# OPTIONAL - Variabili Opzionali per Configurazione Server
# ----------------------------------------------------------------------------

# Porta del server
# Default: 8000
# Su Render, viene impostata automaticamente dalla variabile PORT di Render
PORT=8000

# Host del server
# Default: 127.0.0.1 (localhost)
# Su Render, usa 0.0.0.0 per accettare connessioni da tutte le interfacce
# In locale, 127.0.0.1 Ã¨ sufficiente
HOST=127.0.0.1

# ----------------------------------------------------------------------------
# AUTOMATIC - Variabili Impostate Automaticamente
# ----------------------------------------------------------------------------

# RENDER - Impostata automaticamente da Render quando il servizio Ã¨ in esecuzione
# RENDER_SERVICE_NAME - Impostata automaticamente da Render
# BASE_URL - Aggiornata automaticamente quando ngrok viene avviato
# MCP_ALLOWED_HOSTS - Aggiornata automaticamente quando ngrok viene avviato
# MCP_ALLOWED_ORIGINS - Aggiornata automaticamente quando ngrok viene avviato

# ============================================================================
# NOTE IMPORTANTI
# ============================================================================
#
# 1. MOTHERDUCK_TOKEN Ã¨ OBBLIGATORIO - il server non funzionerÃ  senza di esso
#
# 2. NGROK_AUTH_TOKEN Ã¨ opzionale ma consigliato per sviluppo locale
#    - Se configurato, ngrok verrÃ  avviato automaticamente quando avvii il server
#    - Se non configurato, ngrok non verrÃ  avviato (utile su Render)
#
# 3. BASE_URL, MCP_ALLOWED_HOSTS e MCP_ALLOWED_ORIGINS vengono aggiornate
#    automaticamente quando ngrok viene avviato. Non Ã¨ necessario configurarle
#    manualmente per sviluppo locale.
#
# 4. Su Render:
#    - Imposta BASE_URL con l'URL del tuo servizio (es: https://your-app.onrender.com)
#    - Imposta MCP_ALLOWED_HOSTS con il tuo dominio (es: your-app.onrender.com)
#    - Imposta MCP_ALLOWED_ORIGINS con il tuo URL completo + ChatGPT
#      (es: https://your-app.onrender.com,https://chat.openai.com)
#
# 5. STRIPE_SECRET_KEY Ã¨ necessario solo se usi la funzionalitÃ  di checkout
#
# ============================================================================





